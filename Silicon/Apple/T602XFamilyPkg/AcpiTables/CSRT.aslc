/** @file
  T6020/M2 Pro AIC2 Core System Resource Table.

  This is the Project Mu representation of the versioned, pointer-free ABI in
  drivers/AppleAic/aic2_csrt.h. Keep it byte-for-byte equivalent to the
  m2-pro fixture emitted by drivers/AppleAic/emit_aic2_csrt.c.

  SPDX-License-Identifier: MIT
**/

#include <Base.h>
#include <IndustryStandard/Acpi.h>

// Generated from artifacts/acpi/t6020-m2-pro-aic2/CSRT.bin. Keeping the
// complete table as bytes makes ABI drift mechanically detectable in host
// tests instead of relying on the host and Mu compilers to pack it alike.
//
// This table carries a trailing published-GSIV <-> physical-AIC-line alias
// section (the "ALI2" tail after the fixed 144-byte AIC2 payload). T6020's
// Left-front xHCI, ANS, and right-side xHCI lines 1274/1832/1292 sit in GIC's
// reserved 1024..4095 gap and are refused by Windows' PnP interrupt arbiter,
// so firmware publishes GSIVs 37/38/39. The experimental GPU profile adds the
// AGX mailbox mapping 40 -> 1146 without changing the default table.
// An older HAL or a CSRT without this tail parses as zero aliases and behaves
// identically to the original table.
//
// The media profile's table is a WHOLE separate alternative rather than more
// #if arms interleaved into the byte stream below, for two reasons: the
// existing text stays character-for-character untouched (so every non-media
// profile is provably unchanged, not merely believed to be), and a 296-byte
// table whose length, checksum and three nested sub-lengths all move together
// is far safer transcribed as one block than as five correlated edits.
//
// Bytes generated by drivers/AppleAic/emit_aic2_csrt.c "m2-pro-media" and
// transcribed verbatim; sha256
// a082eb6c95a12a29cdbc71e0c17fcb4091c1c5c48624595512cf5fa0342f16ba.
// The ordinary "m2-pro" table the #else arm carries is
// cdee0da81d9c54c17d2964510271de453ae2ff0428fe0ff13e69efa9406521a5, which
// Tests/test_j414s_media_acpi_contract.py re-derives from this file and
// compares against the emitter, so neither arm can drift from the driver-side
// ABI without a test failure.
//
#if NTASI_ENABLE_MEDIA_PUBLICATION && NTASI_J414S_GPU_RESOURCE_PROFILE
//
// Fail closed at compile time. Published GSIV 40 means the AGX mailbox
// (40 -> 1146) in the GPU table and admac-sio (40 -> 1218) in the media
// table. One number cannot mean two lines, so the two features must never be
// selected together until somebody reallocates them. No shipped profile does:
// PROFILES["media"] sets gpu False and there is no gpu-media profile.
//
#error "NTASI_ENABLE_MEDIA_PUBLICATION and NTASI_J414S_GPU_RESOURCE_PROFILE both claim published GSIV 40"
#endif

#if NTASI_ENABLE_MEDIA_PUBLICATION
UINT8 Csrt[] = {
  //
  // Eight ALI2 aliases: the three fixed entries every profile carries
  // (37 -> 1274 XHC1, 38 -> 1832 ANS, 39 -> 1292 XHC2) plus the five MCA
  // audio translations. The boot USB controller's alias is bit-identical to
  // the ordinary table's, so the media table is a strict superset and the
  // boot path is untouched.
  //
  //   40 -> 1218  admac-sio, IRQ output index 1
  //   41 -> 1211  mca0, I/V sense cluster
  //   42 -> 1213  mca2, jack cluster
  //   43 -> 1221  i2c2, CS42L84
  //   45 -> 1231  dart-sio
  //
  // NOT 44: AIC 44 is claimed by /arm-io/i2c0/hpmBusManager in the live ADT,
  // and tools/verify-j414s-gsiv-allocation.py rejects it. The AOP microphone
  // array and the ISP camera appear nowhere here on purpose -- their lines
  // (631 and 569) are below the carrier's 1019 limit and are published
  // directly, identity mapped, needing no translation entry.
  //
  0x43, 0x53, 0x52, 0x54, 0x28, 0x01, 0x00, 0x00,
  0x00, 0xd8, 0x4e, 0x54, 0x41, 0x53, 0x49, 0x20,
  0x54, 0x36, 0x30, 0x32, 0x41, 0x49, 0x43, 0x32,
  0x01, 0x00, 0x00, 0x00, 0x4e, 0x54, 0x41, 0x53,
  0x01, 0x00, 0x00, 0x00, 0x04, 0x01, 0x00, 0x00,
  0x41, 0x50, 0x50, 0x4c, 0x4e, 0x54, 0x41, 0x53,
  0x08, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0xec, 0x00, 0x00, 0x00,
  0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x41, 0x49, 0x43, 0x32, 0x90, 0x00, 0x00, 0x00,
  0x01, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00,
  0x07, 0x00, 0x00, 0x00, 0x20, 0x60, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x10, 0x8e, 0x02, 0x00, 0x00, 0x00,
  0x00, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0xc0, 0x10, 0x8e, 0x02, 0x00, 0x00, 0x00,
  0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00,
  0x0c, 0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00,
  0x14, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,
  0xa9, 0x07, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00,
  0x01, 0x00, 0x00, 0x00, 0x08, 0x00, 0x00, 0x00,
  0x00, 0x4a, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00,
  0x00, 0x4a, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00,
  0x0c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x41, 0x4c, 0x49, 0x32, 0x01, 0x00, 0x00, 0x00,
  0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x25, 0x00, 0x00, 0x00, 0xfa, 0x04, 0x00, 0x00,
  0x26, 0x00, 0x00, 0x00, 0x28, 0x07, 0x00, 0x00,
  0x27, 0x00, 0x00, 0x00, 0x0c, 0x05, 0x00, 0x00,
  0x28, 0x00, 0x00, 0x00, 0xc2, 0x04, 0x00, 0x00,
  0x29, 0x00, 0x00, 0x00, 0xbb, 0x04, 0x00, 0x00,
  0x2a, 0x00, 0x00, 0x00, 0xbd, 0x04, 0x00, 0x00,
  0x2b, 0x00, 0x00, 0x00, 0xc5, 0x04, 0x00, 0x00,
  0x2d, 0x00, 0x00, 0x00, 0xcf, 0x04, 0x00, 0x00,
};

STATIC_ASSERT (sizeof (Csrt) == 296, "T6020 media CSRT size");
#else
UINT8 Csrt[] = {
#if NTASI_J414S_GPU_RESOURCE_PROFILE
  0x43, 0x53, 0x52, 0x54, 0x08, 0x01, 0x00, 0x00,
  0x00, 0x4c, 0x4e, 0x54, 0x41, 0x53, 0x49, 0x20,
#else
  0x43, 0x53, 0x52, 0x54, 0x00, 0x01, 0x00, 0x00,
  0x00, 0x0b, 0x4e, 0x54, 0x41, 0x53, 0x49, 0x20,
#endif
  0x54, 0x36, 0x30, 0x32, 0x41, 0x49, 0x43, 0x32,
  0x01, 0x00, 0x00, 0x00, 0x4e, 0x54, 0x41, 0x53,
