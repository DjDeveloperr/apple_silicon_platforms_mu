#include <Library/AcpiLib.h>
#include <Library/ArmLib.h>
#include <Library/PcdLib.h>
#include <IndustryStandard/Acpi64.h>
#include <Acpi/AcpiHeader.h>
#include <Acpi/SgiAcpiHeader.h>
#include "T6020J414sTopology.h"


#define DIE_COUNT               1

/*
 * These flags mirror the actual ACPI namespace in the J414s DSDT.  DIE0 and
 * CLU0..CLU2 are processor containers with UIDs 0 and 1..3 respectively.
 * The package contains heterogeneous Blizzard and Avalanche implementations,
 * while the cores within each individual cluster are identical.
 */
#define T6020_PPTT_PACKAGE_FLAGS                                                               \
{                                                                                               \
    EFI_ACPI_6_4_PPTT_PACKAGE_PHYSICAL,                                                        \
    EFI_ACPI_6_4_PPTT_PROCESSOR_ID_VALID,                                                      \
    EFI_ACPI_6_4_PPTT_PROCESSOR_IS_NOT_THREAD,                                                 \
    EFI_ACPI_6_4_PPTT_NODE_IS_NOT_LEAF,                                                        \
    EFI_ACPI_6_4_PPTT_IMPLEMENTATION_NOT_IDENTICAL                                             \
}

#define T6020_PPTT_CLUSTER_FLAGS                                                               \
{                                                                                               \
    EFI_ACPI_6_4_PPTT_PACKAGE_NOT_PHYSICAL,                                                    \
    EFI_ACPI_6_4_PPTT_PROCESSOR_ID_VALID,                                                      \
    EFI_ACPI_6_4_PPTT_PROCESSOR_IS_NOT_THREAD,                                                 \
    EFI_ACPI_6_4_PPTT_NODE_IS_NOT_LEAF,                                                        \
    EFI_ACPI_6_4_PPTT_IMPLEMENTATION_IDENTICAL                                                 \
}


#pragma pack(1)
typedef struct {
    EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR  Core;
} PPTT_CORE;

typedef struct {
    EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR  Cluster;
    UINT32                                  PrivateResources[1];
    PPTT_CORE                              Cores[T6020_J414S_E_CORE_COUNT];
    EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE      L2;
} PPTT_CLUSTER_4;

typedef struct {
    EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR  Cluster;
    UINT32                                  PrivateResources[1];
    PPTT_CORE                              Cores[T6020_J414S_P0_CORE_COUNT];
    EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE      L2;
} PPTT_CLUSTER_3;

typedef struct {
    EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR  Die;
    PPTT_CLUSTER_4                         Blizzard;
    PPTT_CLUSTER_3                         Avalanche0;
    PPTT_CLUSTER_3                         Avalanche1;
} PPTT_DIE;
#pragma pack ()


#define CORE_INIT(DieId, ClusterField, CpuUid)                                                      \
{                                                                                                   \
    /* Parameters for CPU Core */                                                                   \
    EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR_INIT (                                                    \
        0x14,                                                           /* Length */                \
        PPTT_PROCESSOR_CORE_FLAGS,                                      /* Flag */                  \
        OFFSET_OF (EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,                                \
            Dies[DieId].ClusterField),                                  /* Parent */                \
        CpuUid,                                                         /* ACPI Id */               \
        0                                                               /* Private resources */     \
    ),                                                                                              \
}


#define T6020_PPTT_L2_FLAGS                                                                        \
{                                                                                                   \
    EFI_ACPI_6_4_PPTT_CACHE_SIZE_VALID,                                                            \
    EFI_ACPI_6_4_PPTT_NUMBER_OF_SETS_INVALID,                                                      \
    EFI_ACPI_6_4_PPTT_ASSOCIATIVITY_INVALID,                                                       \
    EFI_ACPI_6_4_PPTT_ALLOCATION_TYPE_INVALID,                                                     \
    EFI_ACPI_6_4_PPTT_CACHE_TYPE_VALID,                                                            \
    EFI_ACPI_6_4_PPTT_WRITE_POLICY_INVALID,                                                        \
    EFI_ACPI_6_4_PPTT_LINE_SIZE_INVALID,                                                           \
    EFI_ACPI_6_4_PPTT_CACHE_ID_VALID                                                               \
}

#define T6020_PPTT_L2_INIT(DieId, ClusterField, ClusterId, CacheSize)                               \
    EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE_INIT (                                                       \
        T6020_PPTT_L2_FLAGS,                                           /* known fields only */     \
        0,                                                             /* Last-level cache */      \
        CacheSize,                                                     /* Linux cache-size */      \
        0,                                                             /* Sets not in DT */        \
        0,                                                             /* Ways not in DT */        \
        PPTT_UNIFIED_CACHE_ATTR,                                       /* Linux cache-unified */   \
        0,                                                             /* Line size not in DT */   \
        RD_PPTT_CACHE_ID (DieId, ClusterId, 0, L2Cache)                /* Stable cache ID */       \
    )

#define CLUSTER_4_INIT(DieId, ClusterField, ClusterId, UidBase, CacheSize)                          \
{                                                                                                   \
    /* Parameters for Cluster */                                                                    \
    EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR_INIT (                                                    \
        OFFSET_OF (PPTT_CLUSTER_4, Cores),                              /* Length */                \
        T6020_PPTT_CLUSTER_FLAGS,                                       /* Flag */                  \
        OFFSET_OF (EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,                                \
            Dies[DieId].Die),                                           /* Parent */                \
        ((DieId << 4) | (ClusterId + 1)),                               /* CLU0..2 _UID 1..3 */      \
        1                                                               /* Shared L2 */             \
    ),                                                                                              \
    {                                                                                               \
        OFFSET_OF (EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,                               \
            Dies[DieId].ClusterField.L2),                              /* L2 resource */            \
    },                                                                                              \
    {                                                                                               \
        CORE_INIT (DieId, ClusterField, (UidBase) + 0),                                             \
        CORE_INIT (DieId, ClusterField, (UidBase) + 1),                                             \
        CORE_INIT (DieId, ClusterField, (UidBase) + 2),                                             \
        CORE_INIT (DieId, ClusterField, (UidBase) + 3),                                             \
    },                                                                                              \
    T6020_PPTT_L2_INIT (DieId, ClusterField, ClusterId, CacheSize),                                \
}

#define CLUSTER_3_INIT(DieId, ClusterField, ClusterId, UidBase, CacheSize)                          \
{                                                                                                   \
    EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR_INIT (                                                    \
        OFFSET_OF (PPTT_CLUSTER_3, Cores),                              /* Length */                \
        T6020_PPTT_CLUSTER_FLAGS,                                       /* Flag */                  \
        OFFSET_OF (EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,                                \
            Dies[DieId].Die),                                           /* Parent */                \
        ((DieId << 4) | (ClusterId + 1)),                               /* CLU0..2 _UID 1..3 */      \
        1                                                               /* Shared L2 */             \
    ),                                                                                              \
    {                                                                                               \
        OFFSET_OF (EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,                               \
            Dies[DieId].ClusterField.L2),                              /* L2 resource */            \
    },                                                                                              \
    {                                                                                               \
        CORE_INIT (DieId, ClusterField, (UidBase) + 0),                                             \
        CORE_INIT (DieId, ClusterField, (UidBase) + 1),                                             \
        CORE_INIT (DieId, ClusterField, (UidBase) + 2),                                             \
    },                                                                                              \
    T6020_PPTT_L2_INIT (DieId, ClusterField, ClusterId, CacheSize),                                \
}

#define DIE_INIT(DieId)                                                                             \
{                                                                                                   \
    /* Parameters for DIE (Package) */                                                              \
    EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR_INIT(                                                     \
        OFFSET_OF(PPTT_DIE, Blizzard),                                  /* Length */                \
        T6020_PPTT_PACKAGE_FLAGS,                                       /* Flag */                  \
        0,                                                              /* Parent */                \
        DieId,                                                          /* ACPI Id */               \
        0                                                               /* Private resources */     \
    ),                                                                                              \
    CLUSTER_4_INIT(DieId, Blizzard,   0, T6020_J414S_E_UID_BASE,  T6020_J414S_E_L2_SIZE),           \
    CLUSTER_3_INIT(DieId, Avalanche0, 1, T6020_J414S_P0_UID_BASE, T6020_J414S_P0_L2_SIZE),          \
    CLUSTER_3_INIT(DieId, Avalanche1, 2, T6020_J414S_P1_UID_BASE, T6020_J414S_P1_L2_SIZE),          \
}


#pragma pack(1)
typedef struct {
    EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_HEADER  Header;
    PPTT_DIE                                                 Dies[DIE_COUNT];
} EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE;
#pragma pack ()

EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE Pptt = {
{
    __ACPI_HEADER (
        EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_STRUCTURE_SIGNATURE,
        EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE,
        EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_REVISION
    )
    },
    {
        DIE_INIT(0),
    }
};

VOID * CONST ReferenceAcpiTable = &Pptt;
